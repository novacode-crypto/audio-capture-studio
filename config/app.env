# ============================================================================
# AUDIO CAPTURE STUDIO - PARAMETROS GENERALES DEL SERVICIO
# ----------------------------------------------------------------------------
# Aqui NO se configuran puertos (ver config/ports.env).
# Los cambios requieren reiniciar el servicio (stop.bat + start.bat).
# ============================================================================

# Interfaz de escucha. Solo se aceptan direcciones de loopback (127.0.0.1, ::1, localhost).
SERVICE_HOST=127.0.0.1

# Tamano maximo de archivo aceptado por solicitud (MB).
MAX_UPLOAD_MB=512

# Los ficheros temporales del servicio se eliminan pasado este tiempo (minutos).
TEMP_MAX_AGE_MIN=60

# Token de autenticacion: false = persistente (data/service-token.txt),
# true = se regenera en cada arranque (hay que volver a vincular la extension).
TOKEN_ROTATE_ON_START=false

# IDs de extension permitidos separados por comas. Vacio = cualquier chrome-extension://
# (la autenticacion por token sigue siendo obligatoria).
ALLOWED_EXTENSION_IDS=

# Rutas opcionales a binarios propios (absolutas o relativas a la carpeta del proyecto).
# Si se dejan vacias, se detectan automaticamente: binarios del proyecto, PATH de Windows
# y, como ultimo recurso, los paquetes npm locales. Se recomienda usar FFmpeg y FFprobe
# de la misma distribucion/version.
FFMPEG_PATH=
FFPROBE_PATH=

# Nivel de registro: error | info | debug
LOG_LEVEL=info
